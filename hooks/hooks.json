{
  "description": "Anti AI-slop enforcement — validates prose content for AI writing patterns",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/copy_slop_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
